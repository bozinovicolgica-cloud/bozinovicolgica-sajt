# ---------- Sajt ----------
NEXT_PUBLIC_SITE_URL=https://bozinovicolgica.rs
# pravni naziv firme (LLC) za schema.org, npr. "Bozinovic Health LLC"
NEXT_PUBLIC_LEGAL_NAME=

# ---------- Slike ----------
# Slike se služe sa Cloudinary-ja (cloud: ozdkiori). Upiši "local" za rad bez interneta (koriste se /public/images).
NEXT_PUBLIC_IMAGES=

# ---------- Video (sekcija "Pogledaj ovo pre nego što počneš") ----------
# .mp4 link ili YouTube / Vimeo link
NEXT_PUBLIC_VIDEO_SRC=
# slika koja stoji pre puštanja videa (npr. /images/video-poster.webp)
NEXT_PUBLIC_VIDEO_POSTER=

# ---------- WhatsApp za podršku (samo cifre sa pozivnim, npr. 38160xxxxxxx) ----------
NEXT_PUBLIC_WHATSAPP=

# ---------- Analitika (prazno = isključeno) ----------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Supabase (porudžbine + lead-ovi iz kviza) ----------
# Pokreni supabase/migrations/0001_jetra_landing.sql u SQL editoru
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (Resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM="Olgica Božinović <protokol@bozinovicolgica.rs>"
EMAIL_REPLY_TO=
# na ovu adresu stiže obaveštenje o svakoj novoj porudžbini
OWNER_EMAIL=

# ---------- Webhook (n8n / Make / Airtable / CRM) — opciono ----------
ORDER_WEBHOOK_URL=
QUIZ_WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------- Podaci za uplatu ----------
PAYMENT_RECIPIENT="Olgica Božinović PR ..."
PAYMENT_RECIPIENT_ADDRESS="Ulica i broj, Grad"
# domaći račun (format 160-0000000000000-00); bez njega nema IPS QR koda
PAYMENT_ACCOUNT=
PAYMENT_BANK=
# za uplate iz inostranstva
PAYMENT_IBAN=
PAYMENT_SWIFT=
# dinarski iznos za uplate iz Srbije (ako je prazno, prikazuje se 180 EUR)
PRICE_RSD=
# šifra plaćanja (289 = transakcije po nalogu građana), model poziva na broj (00 ili 97)
PAYMENT_CODE=289
PAYMENT_MODEL=00
PAYMENT_PURPOSE="9 dana spasavanja jetre"
DELIVERY_NOTE="Materijale šaljem na tvoj email čim uplata legne."
