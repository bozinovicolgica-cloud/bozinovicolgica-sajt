# ---------- Sajt ----------
NEXT_PUBLIC_SITE_URL=https://bozinovicolgica.rs
# pravni naziv firme za schema.org (prazno = OB METHOD PUT ZDRAVLJA LLC)
NEXT_PUBLIC_LEGAL_NAME=

# ---------- Slike ----------
# Slike se služe sa Cloudinary-ja (cloud: ozdkiori). Upiši "local" za rad bez interneta (koriste se /public/images).
NEXT_PUBLIC_IMAGES=

# ---------- Video (sekcija "Pogledaj ovo pre nego što počneš") ----------
# .mp4 link ili YouTube / Vimeo link
NEXT_PUBLIC_VIDEO_SRC=
# slika koja stoji pre puštanja videa (npr. /images/video-poster.webp)
NEXT_PUBLIC_VIDEO_POSTER=

# ---------- WhatsApp za podršku (samo cifre sa pozivnim, npr. 38160xxxxxxx) ----------
NEXT_PUBLIC_WHATSAPP=

# ---------- Analitika (prazno = isključeno) ----------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Supabase (porudžbine + lead-ovi iz kviza) ----------
# Pokreni supabase/migrations/0001_jetra_landing.sql u SQL editoru
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (Resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM="Olgica Božinović <protokol@bozinovicolgica.rs>"
EMAIL_REPLY_TO=
# na ovu adresu stiže obaveštenje o svakoj novoj porudžbini
OWNER_EMAIL=

# ---------- Webhook (n8n / Make / Airtable / CRM) — opciono ----------
ORDER_WEBHOOK_URL=
QUIZ_WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------- Stripe (plaćanje karticom) ----------
# Stripe → Developers → API keys. Preporuka: restricted key sa pravima Checkout Sessions: Write.
# Za lokalni rad koristi test ključ (sk_test_...), na Vercel-u live ključ.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://bozinovicolgica.rs/api/stripe/webhook
# događaji: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# cena „Protokol čišćenja jetre“ (live). Prazno = 180 EUR iz lib/content.ts (dobro za test mod)
STRIPE_PRICE_ID=price_1UOgrU34fSQv84LGVGJX7nl1
# jezik Stripe stranice (srpski ne postoji; hr je najbliži)
STRIPE_LOCALE=hr
DELIVERY_NOTE="Materijale ti šaljem na email u roku od 24 sata."
